# ============================================
# ytb2bili 环境变量配置模板
# ============================================
# 
# 使用方法:
# 1. 复制此文件为 .env: cp .env.example .env
# 2. 修改 .env 中的值
# 3. 启动应用时会自动加载 .env 中的敏感配置
#
# 优先级: 环境变量 > config.toml > 默认值
# 注意: .env 文件不会被提交到 Git
# ============================================

# ============================================
# 数据库配置
# ============================================
# DATABASE_PASSWORD=your_database_password

# ============================================

# ============================================
# AI 服务 API Keys
# ============================================
# DeepSeek API Key (用于字幕翻译)
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Gemini API Key (用于元数据生成)
# GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI 兼容 API Key (自定义 AI 服务)
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 百度翻译密钥 (可选)
# BAIDU_TRANSLATE_SECRET=your_baidu_secret

# ============================================
# 云服务配置
# ============================================
# 腾讯云 COS 密钥
# TENCENT_COS_SECRET_KEY=your_cos_secret_key


# ============================================
# 其他服务
# ============================================
# 数据分析加密密钥 (16/24/32 字节)
# ANALYTICS_ENCRYPTION_KEY=your_32_byte_encryption_key_here


# ============================================
# 运行时配置
# ============================================
# 日志级别: debug, info, warn, error
# LOG_LEVEL=info

# 配置文件路径 (默认 config.toml)
# CONFIG_FILE=config.toml

# Cookie 加密密钥 (32 字节)
# 留空则自动生成并保存到 ~/.bili_up/.encryption_key
# 手动生成方法: openssl rand -base64 32 | head -c 32
# COOKIE_ENCRYPTION_KEY=your_32_byte_encryption_key_here
